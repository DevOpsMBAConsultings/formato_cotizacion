<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato de Papel Carta con márgenes optimizados -->
    <record id="paperformat_cotizacion" model="report.paperformat">
        <field name="name">Formato Cotización Carta</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Asignar el Formato de Papel al reporte de Ventas -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="mba_formato_cotizacion.paperformat_cotizacion"/>
    </record>

    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document" priority="30">
        <xpath expr="//*[contains(@t-call, 'layout')]" position="attributes">
            <attribute name="t-call">web.basic_layout</attribute>
        </xpath>

        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"/>
        </xpath>
        
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family: Arial, sans-serif; font-size: 9pt; color: #222; padding: 0px 10px;">
                <style>
                    .terms-note p {
                        margin-bottom: 3px !important;
                        line-height: 1.25 !important;
                    }
                    .terms-note p:last-child {
                        margin-bottom: 0 !important;
                    }
                </style>
                <t t-set="brand_primary" t-value="doc.company_id.primary_color or '#0e4422'"/>
                <t t-set="brand_accent" t-value="doc.company_id.secondary_color or '#f15a24'"/>
                
                <!-- Encabezado con Fallback de Logo -->
                <div class="row mb-3">
                    <div class="col-6">
                        <t t-if="doc.company_id.logo and not doc.company_id.uses_default_logo">
                            <img t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 90px; max-width: 280px; width: auto; display: block;" alt="Logo"/>
                        </t>
                        <t t-else="">
                            <img src="/mba_formato_cotizacion/static/src/img/logo.png" style="max-height: 90px; max-width: 280px; width: auto; display: block;" alt="Logo"/>
                        </t>
                    </div>
                    <div class="col-6 text-end" style="color: #555;">
                        <strong style="color: #111;"><span t-field="doc.company_id.name"/></strong><br/>
                        <span t-field="doc.company_id.street"/><br/>
                        <span t-if="doc.company_id.vat">RUC / NIT: <span t-field="doc.company_id.vat"/><br/></span>
                        <span t-if="doc.company_id.phone">Tel: <span t-field="doc.company_id.phone"/><br/></span>
                        <span t-if="doc.company_id.email"><span t-field="doc.company_id.email"/></span>
                    </div>
                </div>

                <!-- Datos del Cliente y de la Cotización -->
                <div class="row mb-3">
                    <div class="col-6">
                        <strong t-attf-style="display: block; margin-bottom: 2px; color: #{brand_primary};">Cliente</strong>
                        <hr t-attf-style="border-top: 2px solid #{brand_primary}; margin-top: 0px; margin-bottom: 8px; opacity: 1;"/>
                        
                        <t t-if="doc.partner_id.parent_id">
                            <strong>Empresa:</strong> <span t-field="doc.partner_id.parent_id.name"/><br/>
                            <strong>Atención:</strong> <span t-field="doc.partner_id.name"/><br/>
                        </t>
                        <t t-else="">
                            <strong>Nombre:</strong> <span t-field="doc.partner_id.name"/><br/>
                            <t t-if="doc.partner_id.child_ids">
                                <strong>Contacto:</strong> <span t-field="doc.partner_id.child_ids[0].name"/><br/>
                            </t>
                        </t>
                        <span t-if="doc.partner_id.street"><strong>Dirección:</strong> <span t-field="doc.partner_id.street"/><br/></span>
                        <span t-if="doc.partner_id.phone"><strong>Teléfono:</strong> <span t-field="doc.partner_id.phone"/><br/></span>
                        <span t-if="doc.partner_id.email"><strong>Correo:</strong> <span t-field="doc.partner_id.email"/><br/></span>
                        <span t-if="doc.user_id"><strong>Vendedor:</strong> <span t-field="doc.user_id.name"/></span>
                    </div>
                    
                    <div class="col-5 offset-1">
                        <strong t-attf-style="display: block; margin-bottom: 2px; color: #{brand_primary};">Cotización</strong>
                        <hr t-attf-style="border-top: 2px solid #{brand_primary}; margin-top: 0px; margin-bottom: 8px; opacity: 1;"/>
                        <strong>Número:</strong> <span t-field="doc.name"/><br/>
                        <strong>Fecha:</strong> <span t-field="doc.date_order" t-options='{"widget": "date"}'/><br/>
                        <strong t-if="doc.validity_date">Válida hasta:</strong> <span t-field="doc.validity_date" t-if="doc.validity_date"/><br t-if="doc.validity_date"/>
                        <strong t-if="doc.payment_term_id">Términos de pago:</strong> <span t-field="doc.payment_term_id.name" t-if="doc.payment_term_id"/>
                    </div>
                </div>

                <div t-if="doc.client_order_ref" class="mb-2">
                    <strong>Referencia del cliente:</strong> <span t-field="doc.client_order_ref"/>
                </div>

                <!-- Tabla de Líneas con Imagen, Ref, Descripción y Precios -->
                <table class="table table-sm mt-2" style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                    <thead style="display: table-header-group;">
                        <tr t-attf-style="background-color: #{brand_primary}; color: white !important; font-weight: bold; border-bottom: 2px solid #{brand_accent};">
                            <th class="text-center" style="padding: 6px; color: white !important; width: 55px;">Foto</th>
                            <th class="text-start" style="padding: 6px; color: white !important; width: 100px;">Código</th>
                            <th class="text-start" style="padding: 6px; color: white !important;">Descripción</th>
                            <th class="text-center" style="padding: 6px; color: white !important; width: 65px;">Cant.</th>
                            <th class="text-end" style="padding: 6px; color: white !important; width: 85px;">Precio</th>
                            <th class="text-end" style="padding: 6px; color: white !important; width: 90px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line" t-as="line">
                            <tr t-if="not line.display_type" style="border-bottom: 1px solid #e9ecef; page-break-inside: avoid;">
                                <td class="text-center align-middle" style="padding: 4px;">
                                    <t t-if="line.product_id.image_128">
                                        <img t-att-src="line._get_product_image_png_data_uri()" style="max-height: 40px; max-width: 48px; object-fit: contain;" alt="Prod"/>
                                    </t>
                                </td>
                                <td class="text-start align-middle" style="padding: 5px;"><span t-esc="line.product_id.default_code"/></td>
                                <td class="text-start align-middle" style="padding: 5px;"><span t-field="line.name"/></td>
                                <td class="text-center align-middle" style="padding: 5px;"><span t-esc="int(line.product_uom_qty) if line.product_uom_qty.is_integer() else line.product_uom_qty"/></td>
                                <td class="text-end align-middle" style="padding: 5px;"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                <td class="text-end align-middle" style="padding: 5px;"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_section'" style="background-color: #f1f3f5; font-weight: bold; page-break-inside: avoid;">
                                <td colspan="6" class="text-start" style="padding: 6px 8px;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'" style="page-break-inside: avoid;">
                                <td colspan="6" class="text-start" style="padding: 4px 8px; font-style: italic; color: #555;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Términos y condiciones (izquierda) junto al bloque de Totales (derecha) -->
                <div class="row mt-2" style="page-break-inside: avoid;">
                    <div class="col-7">
                        <div t-if="doc.note">
                            <strong style="display: block; margin-bottom: 2px;">Términos y condiciones:</strong>
                            <div class="terms-note" t-field="doc.note" style="color: #444;"/>
                        </div>
                    </div>
                    <div class="col-5">
                        <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                            <tr>
                                <td class="text-start" style="padding: 4px;"><strong>Subtotal</strong></td>
                                <td class="text-end" style="padding: 4px;"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr t-if="doc.amount_tax">
                                <td class="text-start" style="padding: 4px;"><strong>Impuestos</strong></td>
                                <td class="text-end" style="padding: 4px;"><span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr t-attf-style="background-color: #{brand_primary}; color: white; font-weight: bold; border-top: 2px solid #{brand_accent};">
                                <td class="text-start" style="padding: 6px 8px; color: white !important;">TOTAL</td>
                                <td class="text-end" style="padding: 6px 8px; color: white !important;"><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>

            </div>
        </xpath>
    </template>
</odoo>